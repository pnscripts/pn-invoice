#!/usr/bin/env php
<?php

declare(strict_types=1);

use PnScripts\Invoice\Cli\Application;

$autoloaders = [
    __DIR__ . '/../vendor/autoload.php',       // package checkout
    __DIR__ . '/../../../autoload.php',        // installed as a dependency
];

foreach ($autoloaders as $autoloader) {
    if (is_file($autoloader)) {
        require $autoloader;
        break;
    }
}

if (!class_exists(Application::class)) {
    fwrite(STDERR, "Composer autoloader not found. Run \"composer install\".\n");
    exit(2);
}

/** @var list<string> $argv */
exit((new Application())->run($argv));
