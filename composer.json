{
    "name": "pnscripts/pn-invoice",
    "description": "PN Invoice: framework-agnostic PHP library to generate and validate EN 16931 e-invoices in UBL 2.1 and UN/CEFACT CII D16B syntax.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "cii",
        "e-invoice",
        "einvoice",
        "en16931",
        "invoice",
        "peppol",
        "ubl",
        "validation",
        "xml"
    ],
    "homepage": "https://pnscripts.com",
    "authors": [
        {
            "name": "PN Scripts",
            "homepage": "https://pnscripts.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-bcmath": "*",
        "ext-dom": "*",
        "ext-libxml": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^12.5 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "PnScripts\\Invoice\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PnScripts\\Invoice\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/pn-invoice"
    ],
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=512M",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "check": [
            "@cs",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "support": {
        "issues": "https://github.com/pnscripts/pn-invoice/issues",
        "source": "https://github.com/pnscripts/pn-invoice",
        "security": "https://github.com/pnscripts/pn-invoice/security/policy"
    }
}
